{
  "name": "@wangjinding/dsh-opencode-go-usage",
  "version": "1.0.4",
  "description": "OpenCode Go 套餐用量查看：DSH 左侧栏卡片（滚动/本周/本月三条配额进度条 + 重置倒计时 + 刷新按钮），并提供 opencode_usage 工具与 /plugin/opencode-usage 接口。直连 opencode.ai，API Key 不经过浏览器。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "opencode",
    "usage",
    "quota",
    "sidebar"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "author": "wangjinding",
  "homepage": "https://github.com/wangjinding/dsh-opencode-go-usage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangjinding/dsh-opencode-go-usage.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/wangjinding/dsh-opencode-go-usage/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
